# Copie este arquivo para .env e preencha apenas o que usar.
# O .env NUNCA deve ser enviado ao GitHub (está no .gitignore).

# ============ MERCADO LIVRE (recomendado) ============
# 1. Crie uma app em https://developers.mercadolivre.com.br/meus-acessos
# 2. Preencha client id e secret abaixo.
# 3. No cadastro da sua app, defina a Redirect URI exata:
#    http://127.0.0.1:5000/api/ml/callback
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://127.0.0.1:5000/api/ml/callback

# Alternativa: cole aqui um Access Token direto (forma mais simples).
# Obtenha em https://developers.mercadolivre.com.br/meus-acessos
ML_ACCESS_TOKEN=

# ============ SHOPEE (opcional) ============
# Shopee Open API é restrita a parceiros; a API de afiliados =
# pede aprovação em https://open.shopee.com.br
# Preencha apenas se você tiver acesso.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_SHOP_ID=